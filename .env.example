# Скопируйте в .env.local. Обе переменные видны в браузере (NEXT_PUBLIC_),
# секретов здесь быть не должно.

# Адрес API Django. Слеш на конце обязателен — пути клеятся конкатенацией.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/

# Карта в блоке «Карта» — Leaflet + OpenStreetMap, ключ не нужен.

# Адрес самого сайта — для канонических ссылок и превью при шеринге.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Номер счётчика Яндекс.Метрики (только цифры). Пусто — Метрика не
# подключается вовсе: ни скрипта, ни кук. Цели заводятся в кабинете
# Метрики вручную, идентификаторы — в src/lib/analytics/metrika.ts.
NEXT_PUBLIC_YM_COUNTER_ID=
